# GEMINI_API_KEY / VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# FIREBASE FIRESTORE CLOUD DATABASE & REAL-TIME MULTIPLAYER SYNC
# ==============================================================================
# To connect your live multiplayer Cosmos feed to Firebase Firestore:
# 1. Create a Firebase project at https://console.firebase.google.com/
# 2. Add a Web App and enable Cloud Firestore in Test/Production mode.
# 3. Paste the web config keys below:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=


